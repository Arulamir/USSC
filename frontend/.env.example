# Server-side origin of USSC-NODE-MANAGER (must serve /api/monitoring/* JSON; do not use NEXT_PUBLIC_ prefix).
# If unset, /api/monitoring requests fail with JSON 503 instead of falling through to the legacy API.
USSC_NODE_MANAGER_ORIGIN=http://127.0.0.1:5010

# Existing USSC backend API origin (legacy non-monitoring APIs only).
USSC_API_BACKEND_ORIGIN=http://127.0.0.1:5000

# Local-only login bypass: set only in frontend/.env.local for localhost development.
# It never creates a backend admin session and is disabled in production builds.
NEXT_PUBLIC_DEV_LOGIN_BYPASS=false

# Existing optional settings
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_API_BASE_URL=
NINE_ROUTER_API_KEY=
MONACOLISA_API_KEY=
